{
  "schema_version": 1,
  "items": [
    {
      "template_id": "STC-T01-WEIGHTED-SCORE",
      "name": "加权评分",
      "description": "将多个因子或信号状态映射为分数并加权汇总，通过进入和退出阈值生成目标仓位。",
      "status": "READY",
      "version": 1,
      "operator": "WEIGHTED_SCORE",
      "output": "TARGET_POSITION",
      "complexity": "LOW",
      "expression": "score=sum(weight_i*x_i); position=hysteresis(score, entry_threshold, exit_threshold)",
      "when_to_use": "多个弱信息具有可比较方向，且无需按市场状态切换权重。",
      "failure_modes": [
        "同族输入重复计权",
        "权重集中在单一输入",
        "阈值只在孤立参数点有效"
      ],
      "input_slots": [
        {
          "name": "scores",
          "role": "EVIDENCE",
          "description": "参与汇总的数值因子或离散信号状态。",
          "accepted_kinds": ["FACTOR", "SIGNAL"],
          "minimum_items": 2,
          "maximum_items": 20,
          "weight_mode": "SCALAR"
        }
      ],
      "parameters": [
        {
          "name": "entry_threshold",
          "type": "FLOAT",
          "description": "进入目标仓位的评分阈值。",
          "default": 0.5,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "exit_threshold",
          "type": "FLOAT",
          "description": "退出目标仓位的评分阈值。",
          "default": 0.0,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "target_position",
          "type": "FLOAT",
          "description": "信号成立时的目标仓位比例。",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        }
      ]
    },
    {
      "template_id": "STC-T02-GATED-SCORE",
      "name": "机会与确认门控",
      "description": "机会信息负责提出交易，确认信息负责验证，否决信息负责阻断不适用场景。",
      "status": "READY",
      "version": 1,
      "operator": "GATED_SCORE",
      "output": "TARGET_POSITION",
      "complexity": "LOW",
      "expression": "position=target if opportunity>=o and confirmation>=c and not any(veto) else exit_rule",
      "when_to_use": "金融假设能明确拆分为机会、确认和风险否决三种职责。",
      "failure_modes": [
        "确认项实际复制机会项",
        "过滤条件叠加导致样本稀疏",
        "否决规则只解释历史极端事件"
      ],
      "input_slots": [
        {
          "name": "opportunity",
          "role": "OPPORTUNITY",
          "description": "提出潜在交易机会的输入。",
          "accepted_kinds": ["FACTOR", "SIGNAL"],
          "minimum_items": 1,
          "maximum_items": 8,
          "weight_mode": "SCALAR"
        },
        {
          "name": "confirmation",
          "role": "CONFIRMATION",
          "description": "确认机会具备增量信息的输入。",
          "accepted_kinds": ["FACTOR", "SIGNAL"],
          "minimum_items": 1,
          "maximum_items": 8,
          "weight_mode": "SCALAR"
        },
        {
          "name": "veto",
          "role": "RISK_VETO",
          "description": "命中后禁止进入的风险信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 0,
          "maximum_items": 6,
          "weight_mode": "NONE"
        }
      ],
      "parameters": [
        {
          "name": "opportunity_threshold",
          "type": "FLOAT",
          "description": "机会评分最低要求。",
          "default": 0.5,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "confirmation_threshold",
          "type": "FLOAT",
          "description": "确认评分最低要求。",
          "default": 0.5,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "target_position",
          "type": "FLOAT",
          "description": "门控通过时的目标仓位比例。",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        }
      ]
    },
    {
      "template_id": "STC-T03-REGIME-WEIGHTED-SCORE",
      "name": "市场状态分权评分",
      "description": "先识别市场状态，再使用该状态对应的权重汇总多类信息并生成目标仓位。",
      "status": "READY",
      "version": 1,
      "operator": "REGIME_WEIGHTED_SCORE",
      "output": "TARGET_POSITION",
      "complexity": "MEDIUM",
      "expression": "score_t=sum(weight[regime_t,i]*x_ti); position=hysteresis(score_t, entry_threshold, exit_threshold)",
      "when_to_use": "同一信息在趋势和震荡等市场状态中具有稳定且不同的职责。",
      "failure_modes": [
        "市场状态定义使用未来数据",
        "状态切片样本不足",
        "状态权重自由度过高"
      ],
      "input_slots": [
        {
          "name": "regime",
          "role": "REGIME",
          "description": "在决策时点可用的市场状态信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 1,
          "maximum_items": 1,
          "weight_mode": "NONE"
        },
        {
          "name": "scores",
          "role": "EVIDENCE",
          "description": "按市场状态使用不同权重的因子或信号。",
          "accepted_kinds": ["FACTOR", "SIGNAL"],
          "minimum_items": 2,
          "maximum_items": 20,
          "weight_mode": "BY_REGIME"
        }
      ],
      "parameters": [
        {
          "name": "entry_threshold",
          "type": "FLOAT",
          "description": "进入目标仓位的评分阈值。",
          "default": 0.5,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "exit_threshold",
          "type": "FLOAT",
          "description": "退出目标仓位的评分阈值。",
          "default": 0.0,
          "minimum": -10.0,
          "maximum": 10.0,
          "choices": []
        },
        {
          "name": "target_position",
          "type": "FLOAT",
          "description": "评分成立时的目标仓位比例。",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        }
      ]
    },
    {
      "template_id": "STC-T04-EVENT-HOLD",
      "name": "事件触发固定持有",
      "description": "事件出现后建立目标仓位，持有固定交易时段或被退出事件提前结束。",
      "status": "READY",
      "version": 1,
      "operator": "EVENT_HOLD",
      "output": "TARGET_POSITION",
      "complexity": "LOW",
      "expression": "position=target from entry_event until exit_event or holding_sessions elapsed; then cooldown",
      "when_to_use": "机制表现为离散事件后的有限期限收益路径。",
      "failure_modes": [
        "持有期峰值由少数交易决定",
        "事件之间高度重叠",
        "固定持有期掩盖机制衰减"
      ],
      "input_slots": [
        {
          "name": "entry_events",
          "role": "ENTRY_EVENT",
          "description": "触发持仓的一个或多个事件信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 1,
          "maximum_items": 8,
          "weight_mode": "NONE"
        },
        {
          "name": "exit_events",
          "role": "EXIT_EVENT",
          "description": "可选的提前退出信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 0,
          "maximum_items": 8,
          "weight_mode": "NONE"
        }
      ],
      "parameters": [
        {
          "name": "holding_sessions",
          "type": "INTEGER",
          "description": "事件触发后的最长持有交易时段。",
          "default": 5,
          "minimum": 1,
          "maximum": 120,
          "choices": []
        },
        {
          "name": "cooldown_sessions",
          "type": "INTEGER",
          "description": "退出后禁止再次进入的交易时段。",
          "default": 0,
          "minimum": 0,
          "maximum": 120,
          "choices": []
        },
        {
          "name": "entry_logic",
          "type": "CATEGORICAL",
          "description": "多个进入事件之间采用任一或全部关系。",
          "default": "ANY",
          "minimum": null,
          "maximum": null,
          "choices": ["ANY", "ALL"]
        },
        {
          "name": "exit_logic",
          "type": "CATEGORICAL",
          "description": "多个退出事件之间采用任一或全部关系。",
          "default": "ANY",
          "minimum": null,
          "maximum": null,
          "choices": ["ANY", "ALL"]
        },
        {
          "name": "target_position",
          "type": "FLOAT",
          "description": "事件持有期间的目标仓位比例。",
          "default": 1.0,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        }
      ]
    },
    {
      "template_id": "STC-T05-CORE-OVERLAY",
      "name": "核心仓位与战术轮转",
      "description": "保留固定核心仓位，并使用独立战术仓位响应事件，在总资金约束内轮转。",
      "status": "READY",
      "version": 1,
      "operator": "CORE_OVERLAY",
      "output": "TARGET_POSITION",
      "complexity": "MEDIUM",
      "expression": "position=core_position + overlay_position*active(event, holding_sessions, exit_event)",
      "when_to_use": "需要保留长期市场暴露，同时用事件Alpha管理部分战术资金。",
      "failure_modes": [
        "核心仓位掩盖战术Alpha",
        "核心与战术风险重复",
        "仓位拆分仅通过缩仓改善回撤"
      ],
      "input_slots": [
        {
          "name": "overlay_entries",
          "role": "OVERLAY_ENTRY",
          "description": "启动战术仓位的事件信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 1,
          "maximum_items": 8,
          "weight_mode": "NONE"
        },
        {
          "name": "overlay_exits",
          "role": "OVERLAY_EXIT",
          "description": "可选的战术仓位提前退出信号。",
          "accepted_kinds": ["SIGNAL"],
          "minimum_items": 0,
          "maximum_items": 8,
          "weight_mode": "NONE"
        }
      ],
      "parameters": [
        {
          "name": "core_position",
          "type": "FLOAT",
          "description": "持续持有的核心仓位比例。",
          "default": 0.5,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        },
        {
          "name": "overlay_position",
          "type": "FLOAT",
          "description": "事件激活时追加的战术仓位比例。",
          "default": 0.5,
          "minimum": 0.0,
          "maximum": 1.0,
          "choices": []
        },
        {
          "name": "holding_sessions",
          "type": "INTEGER",
          "description": "战术仓位最长持有交易时段。",
          "default": 1,
          "minimum": 1,
          "maximum": 120,
          "choices": []
        },
        {
          "name": "cooldown_sessions",
          "type": "INTEGER",
          "description": "战术仓位退出后的冷却交易时段。",
          "default": 0,
          "minimum": 0,
          "maximum": 120,
          "choices": []
        },
        {
          "name": "entry_logic",
          "type": "CATEGORICAL",
          "description": "多个战术进入事件的组合关系。",
          "default": "ANY",
          "minimum": null,
          "maximum": null,
          "choices": ["ANY", "ALL"]
        },
        {
          "name": "exit_logic",
          "type": "CATEGORICAL",
          "description": "多个战术退出事件的组合关系。",
          "default": "ANY",
          "minimum": null,
          "maximum": null,
          "choices": ["ANY", "ALL"]
        }
      ]
    }
  ]
}
