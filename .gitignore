.venv/
__pycache__/
/.tmp/
.worktrees/
*.py[cod]
*.egg-info/
packages/*/build/
packages/*/dist/

# Local fixed-rule backtest outputs; formal research is tracked in experiments/.
outputs/

# Reproducible SRT publication caches; immutable sources remain tracked.
data/backtest/srt_*_publication.json
data/backtest/srt_*_*.csv.gz
data/backtest/*_strategy_generation.json

# Local runtime state and audit data.
state/

# Local credentials for optional Tushare dataflows.
/.env

# Runtime-only Optuna studies; formal trial exports live in experiment artifacts.
experiments/*/*/runtime/*.db
experiments/*/*/runtime/*.db-wal
experiments/*/*/runtime/*.db-shm
experiments/*/*/runtime/*.db-journal
